# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/managehub_db"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# JWT Secret Key (MUST be at least 32 characters in production; generate via: openssl rand -hex 64)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production_env

# Allowed Client Origin(s) for CORS (comma-separated if multiple, e.g. https://app.managehub.com)
CLIENT_ORIGIN=http://localhost:5173

# Authentication Cookie Name
COOKIE_NAME=managehub_token
